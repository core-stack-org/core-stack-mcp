# Public hostname. Point a DNS A record at this server before starting Caddy.
MCP_HOST=mcp.example.com

# Password for the Compose Postgres user. A $ in this value is expanded by Compose.
POSTGRES_PASSWORD=change-me

# Required to open /access-logs and /clients.
ADMIN_TOKEN=change-me

# Optional. Callers should send their own key in X-API-Key.
CORE_STACK_API_KEY=

# CoRE Stack API origin. No /api/v2 path.
# Public: https://geoserver.core-stack.org
# UAT:    https://uat.core-stack.org:444
# A Cursor client can override this with the X-Core-Stack-Base-Url header.
CORE_STACK_BASE_URL=https://geoserver.core-stack.org
